{
  "expo": {
    "name": "SalePro by Monte",
    "slug": "salepro-by-monte",
    "scheme": "salepro",
    "version": "1.35.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#199fe6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monte.salepro",
      "buildNumber": "1035"
    },
    "android": {
      "package": "com.monte.salepro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#199fe6"
      },
      "versionCode": 1035
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "SALEPRO by MONTE",
      "shortName": "SALEPRO",
      "themeColor": "#199fe6",
      "backgroundColor": "#199fe6",
      "lang": "th"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
