{
  "expo": {
    "name": "SalePro by Monte",
    "slug": "salepro-by-monte",
    "scheme": "salepro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#030b2e" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.monte.salepro" },
    "android": {
      "package": "com.monte.salepro",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#030b2e" }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
